{
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": null,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "bio.rhodejeans.com.br" }], "destination": "/bio.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/flash", "destination": "/wpp.html" },
    { "source": "/sac", "destination": "/sac.html" },
    { "source": "/equipe", "destination": "/wpp.html" },
    { "source": "/rhodemap/:creator", "destination": "/rhodemap/:creator.html" },
    { "source": "/live", "destination": "/live.html" },
    { "source": "/live/:creator([a-z0-9_.-]+)", "destination": "/live.html" },
    { "source": "/encontre-seu-tamanho", "destination": "/tamanho.html" },
    { "source": "/tamanho", "destination": "/tamanho.html" },
    { "source": "/academia", "destination": "/academia.html" },
    { "source": "/academy", "destination": "/academia.html" },
    { "source": "/madrinhas", "destination": "/madrinhas.html" },
    { "source": "/madrinha", "destination": "/madrinhas.html" },
    { "source": "/vira-madrinha", "destination": "/vira-madrinha.html" },
    { "source": "/quero-ser-madrinha", "destination": "/vira-madrinha.html" },
    { "source": "/seja-madrinha", "destination": "/vira-madrinha.html" },
    { "source": "/dash-madrinhas", "destination": "/dash-madrinhas.html" },
    { "source": "/placar-madrinhas", "destination": "/dash-madrinhas.html" },
    { "source": "/privacidade-vitrine", "destination": "/privacidade-vitrine.html" },
    { "source": "/bio-admin", "destination": "/bio-admin.html" },
    { "source": "/admin", "has": [{ "type": "host", "value": "bio.rhodejeans.com.br" }], "destination": "/bio-admin.html" }
  ],
  "headers": [
    {
      "source": "/(admin|hub|acesso|cadastro|bem-vinda|parceria|sac|index|dash-live|live|tamanho|privacidade-vitrine|bio|bio-admin|madrinhas|vira-madrinha|dash-madrinhas)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/rhodemap/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/relay.js": { "maxDuration": 10 },
    "api/copy.js": { "maxDuration": 60 },
    "api/analyze.js": { "maxDuration": 60 },
    "api/cron/[job].js": { "maxDuration": 60 },
    "api/sync-catalogo.js": { "maxDuration": 60 },
    "api/sync-flash-sales.js": { "maxDuration": 30 },
    "api/disparo.js": { "maxDuration": 60 },
    "api/size.js": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/cron/tier-milestones", "schedule": "0 12 * * *" }
  ]
}
